# ── Backend ───────────────────────────────────────────────────
APP_NAME=CV Inference Dashboard

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///./jobs.db

# Redis (used by Celery as broker and result backend)
REDIS_URL=redis://redis:6379/0

# File upload limits
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=jpg,jpeg,png,mp4,avi,mov

# Default model if none specified in upload request
DEFAULT_MODEL=detection

# Storage paths (relative to backend working directory)
UPLOAD_DIR=data/uploads
RESULT_DIR=data/results

# ── Frontend ──────────────────────────────────────────────────
# URL the browser uses to reach the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000